# Copia este archivo como .env.local y completa los valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore).
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Cadena de conexión de tu cluster de MongoDB Atlas.
# Formato: mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Nombre de la base de datos dentro del cluster.
MONGODB_DB=kinemotion

# Llave de cifrado AES-256 para los perfiles clínicos (32 bytes en hex).
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si usas la misma base de datos en local y en producción, usa la MISMA
# llave en ambos: con otra llave, los perfiles ya guardados no se pueden leer.
ENCRYPTION_KEY=

# API key de Anthropic para la supervisión del movimiento con IA (Claude).
# Créala en https://platform.claude.com → API Keys. Sin ella, la cámara y el
# conteo de repeticiones funcionan igual, pero sin supervisión.
ANTHROPIC_API_KEY=

# Cuenta de Gmail que envía los correos y su contraseña de aplicación.
# Requiere verificación en dos pasos: https://myaccount.google.com/apppasswords
# Sin ellas, en desarrollo los correos se imprimen en la terminal.
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# Protege la tarea diaria de recordatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Opcional: dirección pública para los enlaces de los correos. En Vercel se
# usa sola la dirección de producción del proyecto.
APP_URL=
